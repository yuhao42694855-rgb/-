{
  "id": "hot-2026-xian",
  "title": "现在全网最火的一本书",
  "book": "咸的玩笑",
  "author": "刘震云",
  "hook": "刘震云时隔四年的新书《咸的玩笑》，几个月卖了40万册。",
  "quotes": [
    "世上许多玩笑，注定要流着泪把它开完。",
    "当真相还在穿鞋的时候，谎言已经跑遍整个延津县城。",
    "世上最可相信的是时间，时间相信的是变化。",
    "街上走着的每个人，内心都有伤痕，大家都辛苦了。",
    "别跟过去过不去，别跟过不去的人过不去。"
  ],
  "tail": "你最喜欢哪一句？评论区告诉我。"
}
